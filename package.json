{
	"name": "@rodrigodagostino/svelte-draggable-drawer",
	"description": "Create accessible, draggable drawers in Svelte, with keyboard, mouse, and touch support.",
	"version": "0.2.0",
	"author": "Rodrigo D’Agostino <rodrigo.dagostino@proton.me>",
	"keywords": [
		"draggable",
		"drawer",
		"drag",
		"touch",
		"accessible",
		"a11y",
		"svelte",
		"sveltekit",
		"component"
	],
	"license": "MIT",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/rodrigodagostino/svelte-draggable-drawer.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./*.css": {
			"import": "./dist/*.css"
		}
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource/jetbrains-mono": "5.2.8",
		"@fontsource/rubik": "5.2.8",
		"@sveltejs/adapter-auto": "7.0.1",
		"@sveltejs/kit": "2.69.1",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.1.2",
		"@types/node": "^22",
		"eslint": "10.6.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-svelte": "3.20.0",
		"globals": "17.7.0",
		"prettier": "3.9.4",
		"prettier-plugin-svelte": "4.1.1",
		"publint": "0.3.21",
		"svelte": "5.56.4",
		"svelte-check": "4.7.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.62.1",
		"vite": "8.1.3"
	}
}
